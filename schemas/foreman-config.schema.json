{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-foreman.local/schemas/foreman-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agents", "output"],
  "properties": {
    "version": {
      "const": 1
    },
    "entry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["explicit_only", "guided_explicit", "foreman_first_bounded", "codex_cli_foreman_first"]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbosity"],
      "properties": {
        "verbosity": {
          "type": "string",
          "enum": ["quiet", "default", "debug"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_poll_interval_ms"],
      "properties": {
        "worker_poll_interval_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "archive_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notebooklm"],
      "properties": {
        "notebooklm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "auth_mode", "notebook_url", "notebook_id", "secret_ref"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "auth_mode": {
              "type": "string",
              "enum": ["browser"]
            },
            "notebook_url": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "notebook_id": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "secret_ref": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        }
      }
    },
    "tool_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_model", "default_variant", "fallback_mode", "tools"],
      "properties": {
        "default_model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "default_variant": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", null]
        },
        "fallback_mode": {
          "type": "string",
          "enum": ["visible_degraded_host_fallback", "deny_host_fallback"]
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystem", "git", "context7", "fetch", "openaiDeveloperDocs"],
          "properties": {
            "filesystem": { "$ref": "#/definitions/toolRoutingPolicyEntry" },
            "git": { "$ref": "#/definitions/toolRoutingPolicyEntry" },
            "context7": { "$ref": "#/definitions/toolRoutingPolicyEntry" },
            "fetch": { "$ref": "#/definitions/toolRoutingPolicyEntry" },
            "openaiDeveloperDocs": { "$ref": "#/definitions/toolRoutingPolicyEntry" }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "planner", "code specialist", "verifier"],
      "properties": {
        "orchestrator": {
          "allOf": [
            {
              "$ref": "#/definitions/agentConfig"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "captain"
                }
              }
            }
          ]
        },
        "planner": {
          "allOf": [
            {
              "$ref": "#/definitions/agentConfig"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "tactician"
                }
              }
            }
          ]
        },
        "explorer": {
          "allOf": [
            {
              "$ref": "#/definitions/agentConfig"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "scout"
                }
              }
            }
          ]
        },
        "code specialist": {
          "allOf": [
            {
              "$ref": "#/definitions/agentConfig"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "raider"
                }
              }
            }
          ]
        },
        "verifier": {
          "allOf": [
            {
              "$ref": "#/definitions/agentConfig"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "arbiter"
                }
              }
            }
          ]
        }
      }
    },
    "companion_agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companion_reader", "companion_operator"],
      "properties": {
        "companion_reader": {
          "allOf": [
            { "$ref": "#/definitions/agentConfig" },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "companion_reader"
                }
              }
            }
          ]
        },
        "companion_operator": {
          "allOf": [
            { "$ref": "#/definitions/agentConfig" },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "companion_operator"
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "model", "variant", "config_entries"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "variant": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", null]
        },
        "config_entries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolRoutingPolicyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_role", "model", "variant", "allowed_operations", "fallback_mode"],
      "properties": {
        "owner_role": {
          "type": "string",
          "enum": ["orchestrator", "planner", "explorer", "code specialist", "verifier"]
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "variant": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", null]
        },
        "owner_companion_agent": {
          "type": ["string", "null"],
          "enum": ["companion_reader", "companion_operator", null]
        },
        "mutation_owner_role": {
          "type": ["string", "null"],
          "enum": ["orchestrator", "planner", "explorer", "code specialist", "verifier", null]
        },
        "mutation_model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "mutation_variant": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", null]
        },
        "mutation_owner_companion_agent": {
          "type": ["string", "null"],
          "enum": ["companion_reader", "companion_operator", null]
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["read", "mutation"]
          },
          "minItems": 1
        },
        "fallback_mode": {
          "type": "string",
          "enum": ["visible_degraded_host_fallback", "deny_host_fallback"]
        }
      }
    }
  }
}
